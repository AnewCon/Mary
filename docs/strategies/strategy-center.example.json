{
  "name": "QuantOS 日内复核示例",
  "document": "基于用户提供的 V2.4.1 历史恢复规则、V2.5 实验权重及现有 PathMatch 15 根 1m 观察功能的集成示例。它是新配置示例，不是原版策略。筛选数量、数据时效、量能门槛与 A/B 分类为待审批的实现建议。10×，80 USDT 预算，组合保证金≤32、计划止损≤2、单笔计划止损≤0.35，净盈亏比≥1.8。日线异常检查后，按 4H、1H、15M、5M 顺序复核。方向和入场评分独立，保护未核验、行情失效、风险不足时等待。",
  "config": {
    "schemaVersion": 1,
    "strategyId": "quantos-intraday",
    "version": "2.6.0-review.1",
    "market": "BINANCE_DEMO_FUTURES",
    "riskLevel": "HIGH",
    "timeframes": {
      "primary": "5m",
      "entry": "5m",
      "confirmation": [
        "15m",
        "1h",
        "4h"
      ],
      "pathValidation": "1m"
    },
    "screening": {
      "contract": "USDT_PERPETUAL",
      "limit": 10,
      "minQuoteVolumeUsdt": 0,
