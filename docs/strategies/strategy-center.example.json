        "冷却期",
        "15M 结构未确认"
      ]
    },
    "indicators": {
      "trendWeight": 40,
      "derivativesWeight": 20,
      "liquidationWeight": 15,
      "positioningWeight": 10,
      "liquidityWeight": 15
    },
    "scoring": {
      "method": "INDEPENDENT_DIRECTION_AND_ENTRY",
      "minimumDirection": 80,
      "minimumEntry": 80,
      "gradeA": 85,
      "gradeB": 80
